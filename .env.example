# Local Docker Compose settings. Copy to .env and replace the example passwords.
# Never commit .env or use production provider credentials in local development.
NODE_ENV=development
PORT=3000
HOST_PORT=3000
BASE_URL=http://localhost:3000
TIMEZONE=Asia/Kuala_Lumpur

# Local MySQL container. Use long random passwords even for a developer machine.
DB_HOST=db
DB_PORT=3306
DB_USER=merzz_app
DB_PASSWORD=
DB_NAME=merzz_local
DB_ROOT_PASSWORD=
DB_POOL_SIZE=5

# Optional until onboarding. Automation always starts disabled.
TEBAR_API_KEY=
TEBAR_PROFILE_ID=
TEBAR_ACCOUNT_ID=
TEBAR_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
# Optional generator-only sampling overrides. Leave blank to use provider defaults.
OPENROUTER_GENERATOR_TEMPERATURE=
OPENROUTER_GENERATOR_TOP_P=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
