# Local Docker Compose settings. Copy to .env and replace the example passwords.
# Never commit .env or use production provider credentials in local development.
NODE_ENV=development
PORT=3000
HOST_PORT=3000
BASE_URL=http://localhost:3000
TIMEZONE=Asia/Kuala_Lumpur
POST_INTERVAL_HOURS=6

# Local MySQL container. Use long random passwords even for a developer machine.
DB_HOST=db
DB_PORT=3306
DB_USER=merzz_app
DB_PASSWORD=replace-with-a-long-random-local-password
DB_NAME=merzz_local
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
DB_POOL_SIZE=5

# Optional until onboarding. Automation always starts disabled.
TEBAR_API_KEY=
TEBAR_PROFILE_ID=
TEBAR_ACCOUNT_ID=
TEBAR_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
