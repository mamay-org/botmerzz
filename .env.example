# Homelab runtime template for /opt/botmerzz/.env.
# Generate fresh passwords directly on LXC 10027; never commit or share .env.
NODE_ENV=production
PORT=3000
HOST_IP=192.168.0.27
HOST_PORT=3000
BASE_URL=https://botmerzz.sequein.my.id
TIMEZONE=Asia/Kuala_Lumpur
TRUST_PROXY=192.168.0.80

# Dedicated credentials for the new MySQL database.
DB_HOST=db
DB_PORT=3306
DB_NAME=botmerzz
DB_USER=botmerzz_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_POOL_SIZE=5

# Optional provider configuration. Leave empty until onboarding is complete.
TEBAR_API_KEY=
TEBAR_PROFILE_ID=
TEBAR_ACCOUNT_ID=
TEBAR_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
# Optional generator-only sampling overrides. Empty values keep provider defaults.
OPENROUTER_GENERATOR_TEMPERATURE=
OPENROUTER_GENERATOR_TOP_P=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deployment bootstrap begins paused. Change only through a separate operator action.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
LEARNING_CAPTURE_ENABLED=false
LEARNING_ACTIVATION_ENABLED=false
LEARNING_RETRIEVAL_ENABLED=false
LEARNING_PROMPT_INTEGRATION_ENABLED=false
LEARNING_SHADOW_ENABLED=false
LEARNING_RETENTION_ENABLED=false
LEARNING_RETENTION_DAYS=
